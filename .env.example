# Kurio NFT Marketplace - Configurações de Ambiente
# Copie este arquivo para .env.local caso deseje customizar em desenvolvimento local.

# URL base da aplicação (em branco usa a origem atual na Vercel e http://localhost:5173 em dev)
VITE_APP_URL=http://localhost:5173

# Ativação do Mock Service Worker (MSW)
VITE_ENABLE_MSW=true

# Latência padrão dos mocks em milissegundos
VITE_MSW_LATENCY=150

# URL do endpoint de WebSocket / Socket.IO (interceptado pelo MSW)
# Em produção na Vercel, deixe vazio para conectar automaticamente na mesma origem (window.location.origin)
VITE_WS_URL=http://localhost:5173
